# Copy to .env.local for local work, and add the same two variables in Vercel → Project → Settings → Environment Variables.
# Both values are PUBLIC by design (publishable key). Never put a "service_role" or "secret" key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
